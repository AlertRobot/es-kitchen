rules_version = '2';
// E&S Kitchen — who can read and write what.
// Each household's plan, list, pantry, recipes, prices and photos are visible only to its members.
// Joining needs the household's current invite code.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)); }
    function isMember(hid) { return signedIn() && request.auth.uid in household(hid).data.members; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // invite codes: anyone signed in can look up a code they know (no listing)
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && isMember(request.resource.data.hid);
      allow delete: if signedIn() && isMember(resource.data.hid);
    }

    // recipe photos and step photos are shared with everyone using the app; only the person who added one (or someone in their household) can replace it, and only they can delete it
    match /dishThumbs/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource.data.uid == request.auth.uid || (resource.data.get('hid', '') != '' && isMember(resource.data.hid)));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /dishPhotos/{rid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource.data.uid == request.auth.uid || (resource.data.get('hid', '') != '' && isMember(resource.data.hid)));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /stepPhotos/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && request.resource.data.uid == request.auth.uid
        && (resource.data.uid == request.auth.uid || (resource.data.get('hid', '') != '' && isMember(resource.data.hid)));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /households/{hid} {
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && (
        // members can change anything
        request.auth.uid in resource.data.members
        // someone with the invite code may add only themselves
        || (request.resource.data.joinCode == resource.data.inviteCode
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode', 'memberNames']))
      );

      // weeks, people, config, recipes, ingredients, photos, thumbs
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
