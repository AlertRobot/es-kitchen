rules_version = '2';
// Peckish — who can read and write what.
// Peckish is invite-only: nothing can be read or written without a signed-in, verified email on the allowlist
// (/allowed/{email, in lower case}), which is managed in the Firebase console and can never be changed from the app.
// Each household's plan, list, pantry, recipes, prices, ratings and shops are visible only to its members.
// Joining needs the household's current invite code.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.get('email', '').lower(); }
    // one cheap check per request: a verified email with a document in /allowed
    function allowed() {
      return signedIn() && request.auth.token.get('email_verified', false) == true && myEmail() != ''
        && exists(/databases/$(database)/documents/allowed/$(myEmail()));
    }
    function household(hid) { return get(/databases/$(database)/documents/households/$(hid)); }
    function isMember(hid) { return allowed() && request.auth.uid in household(hid).data.members; }

    // the allowlist: you can only see whether your own email is on it; nobody can change it from the app
    match /allowed/{email} {
      allow get: if signedIn() && request.auth.token.get('email_verified', false) == true && myEmail() == email;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }

    // invite codes: anyone on the allowlist can look up a code they know (no listing)
    match /invites/{code} {
      allow get: if allowed();
      allow create: if isMember(request.resource.data.hid);
      allow delete: if isMember(resource.data.hid);
    }

    // recipe photos and step photos are shared with everyone using the app (only people on the allowlist). Whoever adds
    // one says which of their households it's from (checked: they must be in it), so "someone in their household can
    // replace it" can't be faked. Only the person who added one, or someone in that household, can replace it; only the
    // person who added it can delete it.
    function photoOk(field, maxLen) {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.get('hid', '') is string && request.resource.data.get('hid', '') != ''
        && isMember(request.resource.data.hid)
        && request.resource.data[field] is string && request.resource.data[field].size() <= maxLen;
    }
    function mayReplace() {
      return resource.data.uid == request.auth.uid || (resource.data.get('hid', '') != '' && isMember(resource.data.hid));
    }
    match /dishThumbs/{rid} {
      allow read: if allowed();
      allow create: if allowed() && photoOk('thumb', 300000);
      allow update: if allowed() && photoOk('thumb', 300000) && mayReplace();
      allow delete: if allowed() && resource.data.uid == request.auth.uid;
    }
    match /dishPhotos/{rid} {
      allow read: if allowed();
      allow create: if allowed() && photoOk('img', 1000000);
      allow update: if allowed() && photoOk('img', 1000000) && mayReplace();
      allow delete: if allowed() && resource.data.uid == request.auth.uid;
    }
    match /stepPhotos/{id} {
      allow read: if allowed();
      allow create: if allowed() && photoOk('img', 1000000);
      allow update: if allowed() && photoOk('img', 1000000) && mayReplace();
      allow delete: if allowed() && resource.data.uid == request.auth.uid;
    }

    match /households/{hid} {
      allow create: if allowed() && request.resource.data.members == [request.auth.uid];
      allow read: if allowed() && request.auth.uid in resource.data.members;
      allow update: if allowed() && (
        // members can change anything
        request.auth.uid in resource.data.members
        // someone on the allowlist with the invite code may add only themselves. The code is saved with who used it
        // ("CODE.uid"), so the one left there by the last person to join never lets in someone who doesn't know it.
        // (A plain code, from an older copy of the app, counts only when it's written now, not when it's already there.)
        || ((request.resource.data.joinCode == resource.data.inviteCode + '.' + request.auth.uid
              || (request.resource.data.joinCode == resource.data.inviteCode && resource.data.get('joinCode', '') != resource.data.inviteCode))
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode', 'memberNames'])
            // and may only add their own name, not change anyone else's
            && request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid]))
      );

      // weeks, people, config, recipes, ingredients, ratings (only what's under the household: a bare
      // {document=**} would match the household document too, and let any member delete it)
      match /{coll}/{document=**} {
        allow read, write: if coll != 'shops' && isMember(hid);
      }

      // logged shops: the payer's phone sends a shop to the payer's Budgie by itself only when the payer or their Budgie
      // partner logged it, or when the payer said it's theirs. So who logged a shop is always the account that wrote it
      // and never changes; "it's mine" (okBy) can only be said by the account saying it; and a shop still waiting to go
      // (budgie.state 'queued') can't be made to wait again, or have what it would send changed, by anyone.
      // (A shop that isn't waiting to go, like a restored copy or one brought in from Budgie, can say who logged it.)
      function shopState(d) { return d.get('budgie', {}).get('state', ''); }
      function okByFine(before) {
        return request.resource.data.get('okBy', null) == before.get('okBy', null) || request.resource.data.get('okBy', '') == request.auth.uid;
      }
      match /shops/{sid} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid) && okByFine({})
          && (request.resource.data.get('byUid', '') == request.auth.uid || shopState(request.resource.data) != 'queued');
        allow update: if isMember(hid) && okByFine(resource.data)
          && request.resource.data.get('byUid', null) == resource.data.get('byUid', null)
          && (shopState(request.resource.data) != 'queued' || (shopState(resource.data) == 'queued'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'date', 'paidBy', 'split', 'shop', 'source', 'budgie', 'removed'])));
      }
    }
  }
}
